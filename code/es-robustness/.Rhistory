es_edges_to <- list()
for (i in 1:length(species_nodes)){
es_dir <- unlist(strsplit(es_col[i], ";"))
print(es_dir)
print(length(es_dir))
for (j in 1:length(es_dir)){
es_edges_from[[length(es_edges_from) + 1]] <- species_nodes[i]
es_edges_to[[length(es_edges_to) + 1]] <- as.integer(es_dir[j])
}
}
es_edges <- data.frame(es_edges_from, es_edges_to, rep(1, length(es_edges_from)))
names(es_edges) <- c("from", "to", "link_type")
